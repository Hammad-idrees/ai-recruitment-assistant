# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never prefix with NEXT_PUBLIC_ — this key bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (LLM for the deep agent) — get from https://aistudio.google.com/apikey
# Use model "gemini-flash-latest" — newer/older pinned model names may be blocked or have zero free quota for new keys.
GOOGLE_API_KEY=
